{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shams.local/schemas/v1/task.schema.json",
  "title": "Task",
  "description": "Một đơn vị công việc trong Task DAG.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "task_id",
    "title",
    "capability",
    "depends_on",
    "outputs",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "capability": {
      "$ref": "common.schema.json#/$defs/capability"
    },
    "state": {
      "$ref": "common.schema.json#/$defs/task_state"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "logical_id"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "from_task": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "logical_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "logical_id",
          "media_type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "logical_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "media_type": {
            "type": "string"
          },
          "contract": {
            "type": "string",
            "description": "Tên artifact contract, ví dụ unity.csharp_script, mesh.fbx_game_ready"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/acceptance_criterion"
      }
    },
    "budget": {
      "$ref": "common.schema.json#/$defs/budget"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "requires_approval": {
      "type": "boolean",
      "default": false
    },
    "workspace_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Glob đường dẫn worker được ghi, ví dụ Assets/Scripts/Shark/**"
    },
    "provider_hint": {
      "type": "string"
    },
    "created_by": {
      "enum": [
        "planner",
        "template",
        "repair_router",
        "human"
      ]
    },
    "parent_task_id": {
      "$ref": "common.schema.json#/$defs/id"
    }
  }
}
