{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shams.local/schemas/v1/task_dag.schema.json",
  "title": "Task DAG",
  "description": "Kế hoạch do Planner tạo; phải qua validator trước khi ghi task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "plan_id",
    "plan_version",
    "goal",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "plan_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "template": {
      "type": "string",
      "description": "Tên DAG template đã dùng (ADR-108), rỗng nếu tự do"
    },
    "goal": {
      "type": "string"
    },
    "vertical_slice_first": {
      "type": "boolean",
      "default": true
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "task_ids"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "type": "string"
          },
          "task_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "approved_by": {
      "type": "string"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Domain Pack sở hữu kế hoạch (ADR-117)"
    }
  }
}
