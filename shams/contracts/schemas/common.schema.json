{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shams.local/schemas/v1/common.schema.json",
  "title": "Common definitions",
  "description": "Kiểu dùng chung cho mọi contract SHAMS v1.",
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "description": "ID dạng slug, ví dụ task.player_movement"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "task_state": {
      "enum": [
        "PENDING",
        "READY",
        "LEASED",
        "RUNNING",
        "QC_PENDING",
        "ACCEPTED",
        "REPAIR_REQUIRED",
        "STALE",
        "BLOCKED",
        "HUMAN_REVIEW",
        "FAILED",
        "CANCELED"
      ]
    },
    "capability": {
      "type": "string",
      "description": "Tên capability. Danh sách V1 xem capability.schema.json examples; cho phép mở rộng theo dạng domain.sub",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_id",
        "sha256"
      ],
      "properties": {
        "logical_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "path": {
          "type": "string",
          "description": "Đường dẫn tương đối trong workspace hoặc artifact store, chỉ để tiện đọc; hash mới là định danh"
        },
        "media_type": {
          "type": "string"
        }
      }
    },
    "worker_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "kind"
      ],
      "properties": {
        "worker_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "llm_agent",
            "inference",
            "tool",
            "human",
            "mock"
          ]
        },
        "node_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "provider": {
          "type": "string",
          "description": "ollama, llamacpp, comfyui, unity_cli, blender, external:<name>"
        },
        "model": {
          "type": "string"
        },
        "model_version": {
          "type": "string",
          "description": "Digest/tag cụ thể, không dùng 'latest'"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_vram_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "acceptance_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "exists",
            "schema",
            "compile",
            "unit_test",
            "integration_test",
            "runtime_log",
            "screenshot",
            "metric",
            "semantic",
            "visual",
            "human"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "check": {
          "type": "object",
          "description": "Tham số cho checker deterministic, ví dụ {test_filter:'PlayerControllerTests'} hoặc {metric:'fps', op:'>=', value:30}"
        }
      }
    }
  }
}
