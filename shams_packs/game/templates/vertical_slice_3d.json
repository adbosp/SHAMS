      "acceptance_criteria": [
        {
          "id": "ac.player_mesh_valid",
          "description": "Poly ≤ 20k, có UV, scale đúng, đúng một người (rộng ≤ 0.7 × cao)",
          "kind": "schema",
          "check": {
            "type": "${mesh_check}",
            "logical_id": "asset.player.mesh",
            "max_triangles": 20000,
            "require_uv": true,
            "min_size_m": 0.5,
            "max_size_m": 3,
            "max_width_to_height": 0.7
          }
        },
        {
          "id": "ac.player_look",
          "description": "Ảnh preview cho thấy ĐÚNG MỘT nhân vật hình người (hai người trở lên, hay nhiều hình đứng cạnh nhau, là không đạt), có đủ đầu, thân, hai tay và hai chân tới bàn chân (thiếu chân hay cụt ở đùi là không đạt), liền một khối (đầu nối cổ và thân, tay và chân nối vào thân, không bộ phận nào lơ lửng hay tách rời), có đặc điểm khớp mô tả nhân vật trong yêu cầu; chỉ ghép các khối hình học rời nhau thì không đạt",
          "kind": "visual",
          "required": true,
          "check": {
            "type": "vlm",
            "min_score": 6
          }
        }
      ],
      "priority": 40,
      "budget": {
        "max_wall_seconds": 1800,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${models}/Player/**"
      ],
      "params": {
        "height_m": 1.7
      }
    },
