      "max_attempts": 3,
      "workspace_scope": [
        "${models}/**"
      ]
    },
    {
      "task_id": "task.player_concept",
      "title": "Ảnh concept nhân vật chính (để dựng mesh)",
      "description": "single full-body image of one adult person, front view only, standing straight, arms relaxed at the sides, whole body visible from head to feet, centered with empty space above the head and below the feet, small in the frame, isolated on a plain white background, clean 3D character render, neutral studio lighting, realistic proportions, no shadow, no text",
      "capability": "image.concept",
      "params": {
        "negative": "nsfw, nude, multiple people, crowd, character sheet, turnaround, multiple views, reference sheet, sketch, panels, collage, cropped, out of frame, text, watermark, background scenery, child, teen, young-looking, school uniform, trees, plants, flowers, foliage, building, landscape",
        "brief_skip": [
          "background",
          "rendered",
          "render ",
          "style",
          "lighting",
          "daylight",
          "isometric",
          "low-poly",
          "scenery"
        ]
      },
      "depends_on": [
        "task.character_brief"
      ],
      "inputs": [
        {
          "name": "brief",
          "from_task": "task.character_brief",
          "logical_id": "brief.player"
        }
      ],
      "outputs": [
        {
          "name": "player_concept",
          "logical_id": "asset.player.concept",
          "media_type": "image/png",
          "contract": "image.concept"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.player_concept_valid",
          "description": "PNG hợp lệ, nhân vật không chạm mép ảnh (không bị cắt chân, cắt đầu)",
          "kind": "schema",
          "check": {
            "type": "image",
            "min_width": 256,
            "min_height": 256,
            "max_edge_subject": 0.04
          }
        },
        {
          "id": "ac.player_concept_look",
          "description": "Judge only these must-haves: exactly ONE person drawn ONCE (a character sheet, turnaround, several views or sketches fail); the whole body is visible: top of the head AND both feet with shoes are inside the image (cut at the knees or thighs fails); front view; a plain or nearly plain background with no scenery; the person clearly looks like an adult (anyone who looks like a child or teenager fails); gender and main outfit match the character description. Small details such as accessories, a hat, a bag or exact colours do NOT lower the score below passing.",
          "kind": "visual",
          "check": {
            "type": "vlm",
            "min_score": 6
          },
          "required": true
        }
      ],
      "priority": 45,
      "budget": {
        "max_wall_seconds": 900,
        "max_tokens": 20000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${models}/Player/**"
      ]
    },
    {
      "task_id": "task.player_model",
      "title": "Mesh nhân vật chính game-ready",
      "description": "Chỉ dựng MỘT mesh từ ảnh concept: nhân vật chính theo mô tả trong yêu cầu. Không dựng nền, sàn, cảnh hay nhân vật khác. Kích thước thật (người cao khoảng 1.7 m), đứng ở gốc toạ độ, tối đa 20000 tam giác, có UV.",
      "capability": "mesh.image_to_3d",
      "depends_on": [
        "task.player_concept"
