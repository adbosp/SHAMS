          "id": "ac.brief_exists",
          "description": "Có hai file mô tả, mỗi file tả một nhân vật bằng tiếng Anh",
          "kind": "exists",
          "check": {
            "type": "text",
            "min_chars": 40
          }
        }
      ],
      "priority": 50,
      "budget": {
        "max_wall_seconds": 600,
        "max_tokens": 20000
