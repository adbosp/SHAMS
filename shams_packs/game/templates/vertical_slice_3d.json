    {
      "task_id": "task.character_brief",
      "title": "Mô tả ngoại hình nhân vật (cho model vẽ ảnh)",
      "description": "Đọc kỹ yêu cầu dự án: ai là nhân vật người chơi điều khiển, ai là nhân vật (NPC) mà người chơi gặp và tương tác; giữ đúng vai trò và giới tính mà yêu cầu ngụ ý. Với game hẹn hò hay tán tỉnh ('cưa', 'tán', 'hẹn hò', 'làm quen'), NPC là người được tán và có giới tính theo đúng từ trong yêu cầu (ví dụ 'cưa gái' thì NPC là một phụ nữ, 'cưa trai' thì NPC là một người đàn ông); nhân vật chính là người đi tán. Viết cho mỗi nhân vật một đoạn NGẮN BẰNG TIẾNG ANH (tối đa 40 từ) CHỈ MÔ TẢ NGOẠI HÌNH: giới tính, tuổi, vóc dáng, kiểu tóc, trang phục chính và màu sắc. Không viết về nền, cảnh, ánh sáng hay phong cách đồ hoạ (SHAMS tự thêm). Mọi nhân vật là NGƯỜI TRƯỞNG THÀNH: ghi rõ tuổi (ví dụ 'a woman in her late 20s', 'a man in his 30s') và cho mặc trang phục người lớn; không dùng đồng phục học sinh, kiểu tóc hay trang phục gợi trẻ vị thành niên, không mô tả thân hình theo kiểu gợi dục. Mỗi file chỉ tả MỘT người, không nhắc tên thương hiệu hay nhân vật có thật. Mỗi file ghi đúng một lần. Không dùng tên cây, hoa, lá hay cảnh vật, kể cả khi tả hoạ tiết quần áo (viết 'patterned dress', không viết 'floral' hay 'flowers'), vì model vẽ ảnh sẽ vẽ chúng ra nền.",
      "capability": "plan.art_brief",
      "depends_on": [],
      "inputs": [],
      "outputs": [
        {
          "name": "player_brief",
          "logical_id": "brief.player",
          "media_type": "text/plain",
          "contract": "doc.text"
        },
        {
          "name": "npc_brief",
          "logical_id": "brief.npc",
          "media_type": "text/plain",
          "contract": "doc.text"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.brief_exists",
          "description": "Có hai file mô tả, mỗi file tả một nhân vật bằng tiếng Anh",
          "kind": "exists",
          "check": {
            "type": "text",
            "min_chars": 40
          }
        }
