    {
      "task_id": "task.player_model",
      "title": "Mesh nhân vật chính (Qwen 3D, khối hình học)",
      "description": "Build ONE stylised low-poly humanoid character as a scene description (JSON primitives), matching the character description in the inputs. Total height 1.7 m, feet on y=0, centred on the origin, facing +Z. Parts, all touching their neighbours (nothing floating): two shoes, two legs (cylinders from the shoes up to the hips at y≈0.9), hips, torso (box or cylinder up to y≈1.45), neck, head (sphere, radius≈0.12, centre y≈1.58), hair on the head, two arms hanging close to the sides of the torso, two hands. A dress or skirt is a cone or cylinder around the hips and legs. Use the colours of the description for skin, hair and each piece of clothing. Do NOT add a ground plane, floor, scenery or any other object.",
      "capability": "mesh.procedural",
      "depends_on": [
        "task.character_brief"
      ],
      "inputs": [
        {
          "name": "brief",
          "from_task": "task.character_brief",
          "logical_id": "brief.player"
        }
      ],
      "outputs": [
        {
          "name": "player",
          "logical_id": "asset.player.mesh",
          "media_type": "${mesh_mt}",
          "contract": "${mesh_contract}"
        },
        {
          "name": "player_preview",
          "logical_id": "asset.player.preview",
          "media_type": "image/png",
          "contract": "image.preview"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.player_mesh_valid",
          "description": "Poly trong ngân sách, có UV, cao khoảng 1.7 m, đúng một người (rộng ≤ 0.9 × cao)",
          "kind": "schema",
          "check": {
            "type": "${mesh_check}",
            "logical_id": "asset.player.mesh",
            "max_triangles": 20000,
            "require_uv": true,
            "min_size_m": 1.2,
            "max_size_m": 2.4,
            "max_width_to_height": 0.9
          }
        }
      ],
      "priority": 40,
      "budget": {
        "max_wall_seconds": 900,
        "max_tokens": 40000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${models}/Player/**"
      ],
      "params": {
        "builder": "json",
        "height_m": 1.7
      }
    },
    {
      "task_id": "task.npc_model",
      "title": "Mesh NPC (Qwen 3D, khối hình học)",
      "description": "Build ONE stylised low-poly humanoid character as a scene description (JSON primitives), matching the character description in the inputs. Total height 1.7 m, feet on y=0, centred on the origin, facing +Z. Parts, all touching their neighbours (nothing floating): two shoes, two legs (cylinders from the shoes up to the hips at y≈0.9), hips, torso (box or cylinder up to y≈1.45), neck, head (sphere, radius≈0.12, centre y≈1.58), hair on the head, two arms hanging close to the sides of the torso, two hands. A dress or skirt is a cone or cylinder around the hips and legs. Use the colours of the description for skin, hair and each piece of clothing. Do NOT add a ground plane, floor, scenery or any other object.",
