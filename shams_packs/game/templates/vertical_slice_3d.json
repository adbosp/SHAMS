            "require_uv": true,
            "min_size_m": 1.2,
            "max_size_m": 2.4,
            "max_width_to_height": 0.9
          }
        }
      ],
      "priority": 40,
      "budget": {
        "max_wall_seconds": 900,
        "max_tokens": 40000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${models}/Npc/**"
      ],
      "params": {
        "builder": "json",
        "height_m": 1.7
      }
    },
    {
      "task_id": "task.environment_model",
      "title": "Bối cảnh màn chơi (Qwen 3D, khối hình học)",
      "description": "Build the play area named in the project goal as ONE scene description (JSON primitives): a flat ground plane about 30 x 30 m at y=0 with a fitting colour (grass, sand, floor...), and 10 to 30 simple props that make the place recognisable (for a garden: trees made of a trunk cylinder plus a sphere or cone crown, flower beds, bushes, a stone path, a bench, a small fence). Keep the centre (a circle of 4 m around the origin) free so the characters can stand there. Real-world sizes, every prop resting on the ground. No people or characters.",
      "capability": "mesh.procedural",
      "params": {
        "builder": "json"
      },
      "depends_on": [],
      "inputs": [],
      "outputs": [
        {
          "name": "environment",
          "logical_id": "asset.environment.mesh",
          "media_type": "${mesh_mt}",
          "contract": "${mesh_contract}"
        },
        {
          "name": "environment_preview",
          "logical_id": "asset.environment.preview",
          "media_type": "image/png",
          "contract": "image.preview"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.environment_valid",
          "description": "GLB hợp lệ, trong ngân sách poly, rộng vài chục mét",
          "kind": "schema",
          "check": {
            "type": "${mesh_check}",
            "logical_id": "asset.environment.mesh",
            "max_triangles": 40000,
            "min_size_m": 5,
            "max_size_m": 200
          }
        }
      ],
      "priority": 30,
      "budget": {
        "max_wall_seconds": 900,
        "max_tokens": 40000
      },
