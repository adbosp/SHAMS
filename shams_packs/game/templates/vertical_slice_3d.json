{
  "schema_version": "1.0",
  "project_id": "template",
  "plan_id": "plan.template",
  "plan_version": 1,
  "domain": "game",
  "template": "vertical_slice_3d",
  "goal": "Vertical slice 3D chơi được: nhân vật chính, đối tượng sinh ra trong màn chơi, một cơ chế gameplay cốt lõi, HUD, tài nguyên 3D/âm thanh, bản build",
  "vertical_slice_first": true,
  "milestones": [
    {
      "id": "ms.slice1",
      "title": "Vertical slice chơi được",
      "task_ids": [
        "task.project_scaffold",
        "task.player_controller",
        "task.spawner",
        "task.core_mechanic",
        "task.hud",
        "task.player_model",
        "task.npc_model",
        "task.environment_texture",
        "task.sfx_core",
        "task.integration_slice1",
        "task.build_game"
      ]
    }
  ],
  "tasks": [
    {
      "task_id": "task.project_scaffold",
      "title": "Khởi tạo ${engine_display} project + cấu trúc thư mục",
      "description": "Khởi tạo ${engine_display} project + cấu trúc thư mục",
      "capability": "${code}",
      "depends_on": [],
      "inputs": [],
      "outputs": [
        {
          "name": "ProjectBootstrap",
          "logical_id": "project.scaffold",
          "media_type": "${script_mt}",
          "contract": "${script_contract}"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.scaffold_compiles",
          "description": "Project compile không lỗi",
          "kind": "compile"
        }
      ],
      "priority": 80,
      "budget": {
        "max_wall_seconds": 1200,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${scripts}/Core/**"
      ]
    },
    {
      "task_id": "task.player_controller",
      "title": "Điều khiển nhân vật chính 3D",
      "description": "Điều khiển nhân vật chính 3D",
      "capability": "${code}",
      "depends_on": [
        "task.project_scaffold"
      ],
      "inputs": [
        {
          "name": "scaffold",
          "from_task": "task.project_scaffold",
          "logical_id": "project.scaffold"
        }
      ],
      "outputs": [
        {
          "name": "PlayerController",
          "logical_id": "code.player_controller",
          "media_type": "${script_mt}",
          "contract": "${script_contract}"
        },
        {
          "name": "PlayerControllerTests",
          "logical_id": "test.player_controller",
          "media_type": "${script_mt}",
          "contract": "${test_contract}"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.movement_compiles",
          "description": "Compile không lỗi",
          "kind": "compile"
        },
        {
          "id": "ac.movement_tests",
          "description": "PlayMode test di chuyển pass",
          "kind": "unit_test",
          "check": {
            "test_filter": "PlayerControllerTests"
          }
        },
        {
          "id": "ac.movement_screenshot",
          "description": "Screenshot nhân vật ở 2 vị trí",
          "kind": "screenshot",
          "required": false
        }
      ],
      "priority": 70,
      "budget": {
        "max_wall_seconds": 1200,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${scripts}/Player/**"
      ]
    },
    {
      "task_id": "task.spawner",
      "title": "Hệ thống sinh đối tượng trong màn chơi",
      "description": "Hệ thống sinh đối tượng trong màn chơi",
      "capability": "${code}",
      "depends_on": [
        "task.project_scaffold"
      ],
      "inputs": [
        {
          "name": "scaffold",
          "from_task": "task.project_scaffold",
          "logical_id": "project.scaffold"
        }
      ],
      "outputs": [
        {
          "name": "Spawner",
          "logical_id": "code.spawner",
          "media_type": "${script_mt}",
          "contract": "${script_contract}"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.spawner_compiles",
          "description": "Compile không lỗi",
          "kind": "compile"
        },
        {
          "id": "ac.spawner_tests",
          "description": "Test số lượng + bounds",
          "kind": "unit_test",
          "check": {
            "test_filter": "SpawnerTests"
          }
        }
      ],
      "priority": 60,
      "budget": {
        "max_wall_seconds": 1200,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${scripts}/Spawning/**"
      ]
    },
    {
      "task_id": "task.core_mechanic",
      "title": "Cơ chế gameplay cốt lõi",
      "description": "Cơ chế gameplay cốt lõi",
      "capability": "${code}",
      "depends_on": [
        "task.player_controller",
        "task.spawner"
      ],
      "inputs": [
        {
          "name": "player",
          "from_task": "task.player_controller",
          "logical_id": "code.player_controller"
        },
        {
          "name": "spawner",
          "from_task": "task.spawner",
          "logical_id": "code.spawner"
        }
      ],
      "outputs": [
        {
          "name": "CoreMechanic",
          "logical_id": "code.core_mechanic",
          "media_type": "${script_mt}",
          "contract": "${script_contract}"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.mechanic_compiles",
          "description": "Compile không lỗi",
          "kind": "compile"
        },
        {
          "id": "ac.mechanic_tests",
          "description": "Test tương tác giữa nhân vật và đối tượng, trạng thái thay đổi đúng",
          "kind": "unit_test",
          "check": {
            "test_filter": "CoreMechanicTests"
          }
        }
      ],
      "priority": 60,
      "budget": {
        "max_wall_seconds": 1200,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${scripts}/Gameplay/**"
      ]
    },
    {
      "task_id": "task.hud",
      "title": "HUD trạng thái người chơi",
      "description": "HUD trạng thái người chơi",
      "capability": "${code}",
      "depends_on": [
        "task.core_mechanic"
      ],
      "inputs": [
        {
          "name": "mechanic",
          "from_task": "task.core_mechanic",
          "logical_id": "code.core_mechanic"
        }
      ],
      "outputs": [
        {
          "name": "HudController",
          "logical_id": "code.hud",
          "media_type": "${script_mt}",
          "contract": "${script_contract}"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.hud_compiles",
          "description": "Compile không lỗi",
          "kind": "compile"
        },
        {
          "id": "ac.hud_tests",
          "description": "HUD cập nhật khi trạng thái thay đổi",
          "kind": "unit_test",
          "check": {
            "test_filter": "HudTests"
          }
        },
        {
          "id": "ac.hud_screenshot",
          "description": "Screenshot HUD",
          "kind": "screenshot",
          "required": false
        }
      ],
      "priority": 50,
      "budget": {
        "max_wall_seconds": 1200,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${scripts}/UI/**"
      ]
    },
    {
      "task_id": "task.player_model",
      "title": "Mesh nhân vật chính game-ready",
      "description": "Chỉ dựng MỘT mesh: nhân vật chính theo mô tả trong yêu cầu. Không dựng nền, sàn, cảnh hay nhân vật khác. Kích thước thật (người cao khoảng 1.7 m), đứng ở gốc toạ độ, tối đa 20000 tam giác, có UV.",
      "capability": "mesh.text_to_3d",
      "depends_on": [],
      "inputs": [],
      "outputs": [
        {
          "name": "player",
          "logical_id": "asset.player.mesh",
          "media_type": "${mesh_mt}",
          "contract": "${mesh_contract}"
        },
        {
          "name": "player_preview",
          "logical_id": "asset.player.preview",
          "media_type": "image/png",
          "contract": "image.preview"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.player_mesh_valid",
          "description": "Poly ≤ 20k, có UV, scale đúng",
          "kind": "schema",
          "check": {
            "type": "${mesh_check}",
            "logical_id": "asset.player.mesh",
            "max_triangles": 20000,
            "require_uv": true,
            "min_size_m": 0.5,
            "max_size_m": 3
          }
        },
        {
          "id": "ac.player_look",
          "description": "Ảnh preview cho thấy một nhân vật hình người liền một khối (đầu nối cổ và thân, tay và chân nối vào thân, không bộ phận nào lơ lửng hay tách rời), có đặc điểm khớp mô tả nhân vật trong yêu cầu; chỉ ghép các khối hình học rời nhau thì không đạt",
          "kind": "visual",
          "required": true,
          "check": {
            "type": "vlm",
            "min_score": 6
          }
        }
      ],
      "priority": 40,
      "budget": {
        "max_wall_seconds": 1800,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${models}/Player/**"
      ]
    },
    {
      "task_id": "task.npc_model",
      "title": "Mesh đối tượng phụ / NPC",
      "description": "Chỉ dựng MỘT mesh: một nhân vật phụ (NPC) theo mô tả trong yêu cầu. Không dựng nền, sàn, cảnh hay nhân vật khác. Kích thước thật (người cao khoảng 1.7 m), đứng ở gốc toạ độ, tối đa 3000 tam giác, có UV.",
      "capability": "mesh.text_to_3d",
      "depends_on": [],
      "inputs": [],
      "outputs": [
        {
          "name": "npc",
          "logical_id": "asset.npc.mesh",
          "media_type": "${mesh_mt}",
          "contract": "${mesh_contract}"
        },
        {
          "name": "npc_preview",
          "logical_id": "asset.npc.preview",
          "media_type": "image/png",
          "contract": "image.preview"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.npc_mesh_valid",
          "description": "Poly ≤ 3k, có UV",
          "kind": "schema",
          "check": {
            "type": "${mesh_check}",
            "logical_id": "asset.npc.mesh",
            "max_triangles": 3000,
            "require_uv": true,
            "min_size_m": 0.3,
            "max_size_m": 3
          }
        },
        {
          "id": "ac.npc_look",
          "description": "Ảnh preview cho thấy một nhân vật hình người liền một khối (đầu nối cổ và thân, tay và chân nối vào thân, không bộ phận nào lơ lửng hay tách rời)",
          "kind": "visual",
          "check": {
            "type": "vlm",
            "min_score": 6
          }
        }
      ],
      "priority": 40,
      "budget": {
        "max_wall_seconds": 1800,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${models}/Npc/**"
      ]
    },
    {
      "task_id": "task.environment_texture",
      "title": "Texture môi trường",
      "description": "seamless tileable top-down ground texture, natural ground surface such as grass, soil or a stone path, flat even lighting, orthographic view from directly above, no objects, no people, no buildings, no horizon, no perspective",
      "capability": "image.texture",
      "depends_on": [],
      "inputs": [],
      "outputs": [
        {
          "name": "environment",
          "logical_id": "asset.environment.texture",
          "media_type": "image/png",
          "contract": "image.texture"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.texture_valid",
          "description": "PNG lũy thừa 2, ≤ 2048",
          "kind": "schema",
          "check": {
            "type": "image",
            "power_of_two": true,
            "max_width": 2048,
            "max_height": 2048,
            "min_width": 64
          }
        },
        {
          "id": "ac.texture_look",
          "description": "A flat, tileable ground texture seen from directly above (no scene, no horizon, no people, no buildings)",
          "kind": "visual",
          "check": {
            "type": "vlm",
            "min_score": 6
          }
        }
      ],
      "priority": 30,
      "budget": {
        "max_wall_seconds": 1200,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${textures}/**"
      ]
    },
    {
      "task_id": "task.sfx_core",
      "title": "Âm thanh cho hành động chính",
      "description": "Âm thanh cho hành động chính",
      "capability": "audio.sfx",
      "depends_on": [],
      "inputs": [],
      "outputs": [
        {
          "name": "mechanic",
          "logical_id": "asset.sfx.core",
          "media_type": "audio/wav",
          "contract": "audio.sfx"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.sfx_valid",
          "description": "WAV 48 kHz, peak ≤ −1 dBFS",
          "kind": "schema"
        }
      ],
      "priority": 30,
      "budget": {
        "max_wall_seconds": 1200,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${audio}/**"
      ]
    },
    {
      "task_id": "task.integration_slice1",
      "title": "Tích hợp vertical slice 1",
      "description": "Tích hợp vertical slice 1",
      "capability": "integration",
      "depends_on": [
        "task.player_controller",
        "task.spawner",
        "task.core_mechanic",
        "task.hud",
        "task.player_model",
        "task.npc_model",
        "task.environment_texture",
        "task.sfx_core"
      ],
      "inputs": [
        {
          "name": "player",
          "from_task": "task.player_controller",
          "logical_id": "code.player_controller"
        },
        {
          "name": "spawner",
          "from_task": "task.spawner",
          "logical_id": "code.spawner"
        },
        {
          "name": "mechanic",
          "from_task": "task.core_mechanic",
          "logical_id": "code.core_mechanic"
        },
        {
          "name": "hud",
          "from_task": "task.hud",
          "logical_id": "code.hud"
        },
        {
          "name": "player_mesh",
          "from_task": "task.player_model",
          "logical_id": "asset.player.mesh"
        },
        {
          "name": "npc_mesh",
          "from_task": "task.npc_model",
          "logical_id": "asset.npc.mesh"
        },
        {
          "name": "environment",
          "from_task": "task.environment_texture",
          "logical_id": "asset.environment.texture"
        },
        {
          "name": "sfx",
          "from_task": "task.sfx_core",
          "logical_id": "asset.sfx.core"
        }
      ],
      "outputs": [
        {
          "name": "Slice1",
          "logical_id": "scene.slice1",
          "media_type": "${scene_mt}",
          "contract": "${scene_contract}"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.slice_compiles",
          "description": "Compile không lỗi",
          "kind": "compile"
        },
        {
          "id": "ac.slice_integration",
          "description": "Integration PlayMode test",
          "kind": "integration_test"
        },
        {
          "id": "ac.slice_runtime",
          "description": "Chạy 30 s không exception",
          "kind": "runtime_log"
        },
        {
          "id": "ac.slice_screenshot",
          "description": "Screenshot vòng chơi",
          "kind": "screenshot",
          "required": false
        }
      ],
      "priority": 60,
      "budget": {
        "max_wall_seconds": 1200,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${scenes}/**"
      ]
    },
    {
      "task_id": "task.build_game",
      "title": "Build ${build_target} + smoke test",
      "description": "Build ${build_target} + smoke test",
      "capability": "${build}",
      "depends_on": [
        "task.integration_slice1"
      ],
      "inputs": [
        {
          "name": "scene",
          "from_task": "task.integration_slice1",
          "logical_id": "scene.slice1"
        }
      ],
      "outputs": [
        {
          "name": "Game",
          "logical_id": "build.game",
          "media_type": "${build_mt}",
          "contract": "${build_contract}"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac.build_ok",
          "description": "Build thành công",
          "kind": "compile"
        },
        {
          "id": "ac.smoke",
          "description": "Chạy 30 s, log sạch",
          "kind": "runtime_log"
        },
        {
          "id": "ac.fps",
          "description": "FPS ≥ 30",
          "kind": "metric",
          "check": {
            "metric": "fps",
            "op": ">=",
            "value": 30
          }
        }
      ],
      "priority": 60,
      "budget": {
        "max_wall_seconds": 900,
        "max_tokens": 60000
      },
      "max_attempts": 3,
      "workspace_scope": [
        "${builds}/**"
      ]
    }
  ]
}
